---
interface Props {
  alt?: string;
  class?: string;
  width?: number;
  height?: number;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'low' | 'auto';
}

const {
  alt = 'Prefeitura de São José do Belmonte',
  class: className = 'h-10 object-contain drop-shadow-sm',
  width = 200,
  height = 60,
  loading = 'eager',
  fetchpriority = 'high',
} = Astro.props;
---

<picture>
  <source srcset="/assets/logo.avif" type="image/avif" />
  <source srcset="/assets/logo.webp" type="image/webp" />
  <img
    src="/assets/logo.png"
    alt={alt}
    class={className}
    width={width}
    height={height}
    loading={loading}
    fetchpriority={fetchpriority}
    decoding="async"
  />
</picture>
