---
import type { Pendencia } from '../lib/nomes';
import { agruparPendencias, normalizarBusca } from '../lib/nomes';

interface Props {
  pendencias: Pendencia[];
}

const { pendencias } = Astro.props;
const grupos = agruparPendencias(pendencias);
const letras = Object.keys(grupos).sort();
---

<section class="fade-in mt-12" style="animation-delay: 0.4s;">
  <div class="flex flex-col items-center text-center mb-6">
    <div class="bg-amber-50 p-4 rounded-full mb-4">
      <i data-lucide="alert-triangle" class="w-8 h-8 text-amber-500"></i>
    </div>
    <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight mb-2">
      Pendência de <span class="text-amber-500">Documentos</span>
    </h2>
    <p class="text-slate-500 leading-relaxed text-[15px] max-w-sm mx-auto font-medium">
      As pessoas abaixo precisam regularizar a documentação para que o RG possa ser emitido.
    </p>
  </div>

  <div id="listaPendencias" class="space-y-6">
    {
      letras.map((letra) => (
        <div class="relative grupo-pendencia" data-grupo-pendencia>
          <h2 class="sticky top-[130px] z-30 inline-block bg-[#f5f5f7]/95 backdrop-blur-sm text-amber-500 font-bold text-[17px] py-1 px-1 mb-2 w-full border-b border-slate-200/60">
            {letra}
          </h2>
          <div class="bg-white rounded-[20px] shadow-sm border border-slate-200/60 overflow-hidden">
            <ul class="divide-y divide-slate-100">
              {grupos[letra].map((item) => (
                <li
                  class="item-pendencia px-5 py-3.5 flex items-center space-x-3 active:bg-slate-50 transition-colors"
                  data-search-text={normalizarBusca(item.nome)}
                >
                  <div class="w-8 h-8 rounded-full bg-amber-50 flex items-center justify-center text-amber-500 text-sm font-medium shrink-0">
                    {letra}
                  </div>
                  <div class="flex flex-col min-w-0">
                    <span class="text-[16px] text-slate-800 font-medium tracking-tight">{item.nome}</span>
                    <span class="text-[13px] text-amber-600 font-medium mt-0.5 truncate">
                      Pendência: {item.pendencia}
                    </span>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))
    }
  </div>
</section>
